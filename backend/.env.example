# OpenAI (used only for embeddings)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic (used for chat + structured extraction)
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-5

# Postgres (with pgvector extension enabled)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=lokt  
POSTGRES_PASSWORD=lokt
POSTGRES_DATABASE=lokt

# Retrieval / hallucination-prevention tuning
RETRIEVAL_TOP_K=8
RETRIEVAL_CONFIDENCE_THRESHOLD=0.40
